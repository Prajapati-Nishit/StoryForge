# Copy this file to .env and fill in values, or export as real environment
# variables before running manage.py. StoryForge works with none of these
# set (it uses SQLite and an offline story generator by default).

DJANGO_SECRET_KEY=change-me-to-a-random-secret-string
DJANGO_DEBUG=True

# Optional: point at a different local/remote Ollama server or model.
# Defaults below work out of the box if Ollama is running locally with
# the model pulled (ollama pull llama3.1).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
